 "finding": {
  "title": "Rs 21,436 excess tax on INV-2526-01431: charged 28 percent, the rate is 18 percent since 22 Sep 2025",
  "label": "Wrong GST rate",
  "impact_paise": 2143630,
  "impact_type": "excess_tax",
  "confidence": 1,
  "party": "Delta Traders Private Limited",
  "record": "INV-2526-01431",
  "invoice_date": "2025-09-25",
  "diff": [
   {
    "field": "tax_rate_pct",
    "label": "GST rate",
    "left": 28,
    "right": null,
    "expected": 18,
    "differs": true
   },
   {
    "field": "total_tax_paise",
    "label": "Total tax",
    "left": 6002165,
    "right": null,
    "expected": 3858535,
    "differs": true
   }
  ],
  "rule_ref": "Effective rate on the invoice date",
  "reason": "HSN 8528 (Large Electronic Appliances) was taxed at 28 percent. The rate in force on 25 Sep 2025 is 18 percent. The rate changed on 22 Sep 2025.",
  "rule_text": "The GST rate must be the one in force for that HSN code on the invoice date.",
  "what_to_do": "Issue a credit note to the Customer for the excess tax and correct the invoice.",
  "draft": {
   "recipient": "Delta Traders Private Limited (accounts)",
   "subject": "Credit note for invoice INV-2526-01431",
   "body": "Dear Delta Traders Private Limited team,\n\nWe have reviewed invoice INV-2526-01431 dated 25 Sep 2025 and identified that HSN 8528 was charged at 28 percent instead of the applicable 18 percent rate effective from 22 Sep 2025. Consequently, an excess tax of Rs 21,436 was applied.\n\nWe will issue a credit note for Rs 21,436 and provide a corrected invoice. Please update your records accordingly.\n\nAccounts team\nSharma Traders Pvt Ltd\nGSTIN 07AAACS1234F1ZU",
   "source": "cache"
  }
 },
